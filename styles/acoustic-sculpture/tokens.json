{
  "schema_version": 1,
  "color": {
    "background": "#F3EBDD",
    "surface": "#E8DFD1",
    "text": "#142D40",
    "muted": "#455662",
    "accent": "#9D5238",
    "on_accent": "#FFFFFF",
    "border": "#7C6A57",
    "focus": "#142D40"
  },
  "typography": {
    "display": {
      "family": "Trebuchet MS",
      "fallback_stack": [
        "Arial",
        "sans-serif"
      ],
      "source": "system"
    },
    "body": {
      "family": "Georgia",
      "fallback_stack": [
        "Times New Roman",
        "serif"
      ],
      "source": "system"
    },
    "size": {
      "small": "0.875rem",
      "body": "1rem",
      "heading": "2.8rem",
      "display": "6rem"
    },
    "weight": {
      "regular": 400,
      "bold": 700
    },
    "line_height": {
      "body": 1.6,
      "heading": 1.1
    },
    "letter_spacing": {
      "body": "0em",
      "heading": "-0.02em"
    },
    "language_test": "\u0104\u010c\u0118\u0116\u012e\u0160\u0172\u016a\u017d \u0105\u010d\u0119\u0117\u012f\u0161\u0173\u016b\u017e"
  },
  "spacing": {
    "small": "0.5rem",
    "medium": "1rem",
    "large": "2rem",
    "section": "4rem"
  },
  "radius": {
    "none": "0",
    "small": "0.25rem"
  },
  "shadow": {
    "none": "none"
  },
  "motion": {
    "duration": {
      "instant": 0,
      "short": 150,
      "intro": 1200
    },
    "easing": {
      "standard": "ease-out"
    },
    "reduced_motion": "Remove nonessential transforms and transitions; keep all content visible."
  },
  "layout": {
    "content_max_width": "90rem",
    "text_max_width": "65ch",
    "breakpoints": {
      "tablet": 768,
      "desktop": 1024
    }
  },
  "contrast_pairs": [
    {
      "foreground": "text",
      "background": "background",
      "purpose": "Body text",
      "minimum_ratio": 4.5
    },
    {
      "foreground": "muted",
      "background": "surface",
      "purpose": "Secondary text",
      "minimum_ratio": 4.5
    },
    {
      "foreground": "on_accent",
      "background": "accent",
      "purpose": "Action labels",
      "minimum_ratio": 4.5
    },
    {
      "foreground": "focus",
      "background": "background",
      "purpose": "Focus outline",
      "minimum_ratio": 3
    }
  ]
}
