{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "previews-manifest.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "environment": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "browser": {
          "type": "string",
          "minLength": 1
        },
        "browser_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "device_scale_factor": {
          "type": "number",
          "minimum": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "playwright": {
          "type": "string",
          "minLength": 1
        },
        "color_scheme": {
          "type": "string",
          "minLength": 1
        },
        "reduced_motion": {
          "type": "string",
          "minLength": 1
        },
        "fixed_time": {
          "type": "string",
          "minLength": 1
        },
        "random_seed": {
          "type": "integer",
          "minimum": 1
        },
        "renderer_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "node",
        "browser",
        "browser_version",
        "platform",
        "device_scale_factor",
        "locale",
        "timezone",
        "playwright",
        "color_scheme",
        "reduced_motion",
        "fixed_time",
        "random_seed",
        "renderer_version"
      ],
      "additionalProperties": false
    },
    "previews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "style_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "variant": {
            "type": "string",
            "enum": [
              "a",
              "b"
            ]
          },
          "viewport": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\?#:])[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "style_id",
          "variant",
          "viewport",
          "path",
          "width",
          "height",
          "output_sha256",
          "source_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "environment",
    "previews"
  ],
  "additionalProperties": false
}
