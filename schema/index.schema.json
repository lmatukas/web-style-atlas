{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "family": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "Member of core/vocabularies.json families; checked by source validation."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "best_for": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "avoid_for": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "density": {
            "type": "string",
            "enum": [
              "sparse",
              "balanced",
              "dense"
            ]
          },
          "image_dependency": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "motion_level": {
            "type": "string",
            "enum": [
              "none",
              "subtle",
              "expressive"
            ]
          },
          "complexity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "signature": {
            "type": "object",
            "properties": {
              "composition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "typography": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "navigation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "content_rhythm": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "imagery": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "color_and_material": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "interaction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "motion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "composition",
              "typography",
              "navigation",
              "content_rhythm",
              "imagery",
              "color_and_material",
              "interaction",
              "motion"
            ],
            "additionalProperties": false
          },
          "status": {
            "const": "ready"
          },
          "style_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\?#:])[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "variants": {
            "type": "array",
            "prefixItems": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "a"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reference_path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\?#:])[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                  },
                  "preview_path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\?#:])[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                  },
                  "preview_mobile_path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\?#:])[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "reference_path",
                  "preview_path",
                  "preview_mobile_path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "b"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reference_path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\?#:])[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                  },
                  "preview_path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\?#:])[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                  },
                  "preview_mobile_path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\?#:])[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "reference_path",
                  "preview_path",
                  "preview_mobile_path"
                ],
                "additionalProperties": false
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "prompt_path": {
            "type": "string",
            "pattern": "^prompts/[a-z][a-z0-9]*(?:-[a-z0-9]+)*/prompt\\.lt\\.md$",
            "description": "Optional full creation prompt. Must match this style ID and its public brief registry entry."
          }
        },
        "required": [
          "schema_version",
          "id",
          "name",
          "summary",
          "family",
          "tags",
          "best_for",
          "avoid_for",
          "density",
          "image_dependency",
          "motion_level",
          "complexity",
          "signature",
          "status",
          "style_path",
          "variants"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "styles"
  ],
  "additionalProperties": false
}
