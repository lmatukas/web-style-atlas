{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "renderer": {
      "enum": [
        "webgl",
        "svg",
        "canvas2d",
        "html"
      ]
    },
    "audio": {
      "type": "boolean"
    },
    "stable_state": {
      "const": "reduced-motion"
    },
    "motion": {
      "const": "finite-with-pause"
    },
    "static_fallback": {
      "type": "string",
      "pattern": "^assets/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.(?:svg|png)$"
    }
  },
  "required": [
    "schema_version",
    "renderer",
    "audio",
    "stable_state",
    "motion"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "static_fallback"
        ],
        "properties": {
          "static_fallback": {}
        }
      },
      "then": {
        "properties": {
          "renderer": {
            "const": "webgl"
          }
        }
      }
    }
  ]
}
