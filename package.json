{
  "name": "web-style-atlas",
  "version": "1.1.0",
  "private": true,
  "description": "A visual atlas of distinct web design directions for AI coding agents.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "tasks:next": "node scripts/tasks.mjs next",
    "tasks:validate": "node scripts/tasks.mjs validate",
    "tasks:render": "node scripts/tasks.mjs render",
    "tasks:check": "node scripts/tasks.mjs check",
    "test": "npm run test:unit",
    "check:contract": "node --test tests/contract.test.mjs",
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test:unit": "node --test tests/*.test.mjs",
    "previews": "node scripts/previews.mjs",
    "test:previews": "node --test tests/browser/previews.test.mjs",
    "test:browser": "node scripts/browser-qa.mjs",
    "dev": "node scripts/dev.mjs",
    "test:gallery": "node --test tests/browser/gallery.test.mjs",
    "ci:generated": "node scripts/ci.mjs generated"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "axe-core": "4.12.1",
    "playwright": "1.62.1",
    "yaml": "2.9.1"
  }
}
